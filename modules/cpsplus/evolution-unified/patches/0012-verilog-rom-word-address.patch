diff --git a/modules/jtframe/hdl/sdram/jtframe_romrq_bcache.v b/modules/jtframe/hdl/sdram/jtframe_romrq_bcache.v
--- a/modules/jtframe/hdl/sdram/jtframe_romrq_bcache.v
+++ b/modules/jtframe/hdl/sdram/jtframe_romrq_bcache.v
@@ -73,8 +73,9 @@
 
 `ifdef CPS2_QSND32
 // An 8-bit ROM consumer has one more byte-address bit than SDRAM words.
-wire [SDRAMW-1:0] rom_word_addr = SDRAMW'(addr_req >> (DW==8));
-assign sdram_addr = offset + rom_word_addr;
+localparam ROM_WORD_AW = AW-(DW==8);
+wire [ROM_WORD_AW-1:0] rom_word_addr = addr_req[AW-1:(DW==8)];
+assign sdram_addr = offset + {{SDRAMW-ROM_WORD_AW{1'b0}},rom_word_addr};
 `else
 assign sdram_addr = offset + { {SDRAMW-AW{1'b0}}, addr_req>>(DW==8)};
 `endif
