+`endif
 always @(posedge clk) begin
     if((ioctl_rom && !native_last_rom) || (ioctl_wr && ioctl_rom && ioctl_addr==0)) native_sample32<=0;
     else if(ioctl_wr && ioctl_rom && !ioctl_ram && ioctl_addr==14) native_sample32<=ioctl_dout==3;
