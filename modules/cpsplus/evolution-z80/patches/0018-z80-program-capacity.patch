diff --git a/modules/jtframe/hdl/inc/jtframe_cps2_native.vh b/modules/jtframe/hdl/inc/jtframe_cps2_native.vh
--- a/modules/jtframe/hdl/inc/jtframe_cps2_native.vh
+++ b/modules/jtframe/hdl/inc/jtframe_cps2_native.vh
@@ -77,3 +77,28 @@
     begin native_fixed = address < 16 || address >= 64; end
 endfunction
 `endif
+
+`ifdef CPS2_Z80_512
+`ifndef CPS2_QSND32
+    `CPS2_Z80_512_requires_CPS2_QSND32
+`endif
+// Same descriptor, with the Z80 extent and every following start checked.
+function [7:0] native_expected_z80;
+    input [6:0] address;
+    input wide, expanded;
+    reg [31:0] word_value;
+    integer lane;
+    begin
+        for(lane=0;lane<4;lane=lane+1)
+            word_value[lane*8+:8]=native_expected_profile({address[6:2],2'b00}+lane[6:0],wide);
+        if(expanded) case(address[6:2])
+            5'd0: word_value=word_value+32'h01000000;
+            5'd1: word_value=word_value+32'h01000100;
+            5'd21: word_value=32'h00080000;
+            5'd22,5'd24,5'd26,5'd28: word_value=word_value+32'h00040000;
+            default: ;
+        endcase
+        native_expected_z80=word_value[{address[1:0],3'b000}+:8];
+    end
+endfunction
+`endif
