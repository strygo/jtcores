+`ifdef CPS2_GFX64
+    ,output reg         cps2_gfx_full = 1'b0
+`endif
 );
 
 assign dwnld_busy = ioctl_rom;
@@ -149,12 +152,30 @@
 // A fresh download clears authorization at byte 0; a user reset retains it.
